---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { content } from '../lib/content';
import { assetUrl } from '../lib/urls';
import { youtubeEmbedUrl } from '../lib/video';
const { home, companies } = content;
const showreelEmbed = youtubeEmbedUrl(home.showreel.video);
---
<Layout>
  <section id="info" class="intro-section panel" aria-labelledby="intro-heading">
    <div class="showreel-panel" aria-label={home.showreel.label}>
    {showreelEmbed ? <div class="showreel-frame showreel-frame--embed">
      <iframe
        src={showreelEmbed}
        title={home.showreel.label}
        width="1440"
        height="810"
        loading="eager"
        allow="autoplay; encrypted-media"
        referrerpolicy="strict-origin-when-cross-origin"
        tabindex="-1"
      ></iframe>
    </div> : home.showreel.video ? <div class="showreel-frame"><video autoplay muted loop playsinline disablepictureinpicture preload="metadata" poster={home.showreel.poster ? assetUrl(home.showreel.poster) : undefined} aria-label={home.showreel.label}>
      <source src={assetUrl(home.showreel.video)} />
      {home.showreel.captions && <track kind="captions" src={assetUrl(home.showreel.captions)} srclang="en" label="English" default />}
      <a href={assetUrl(home.showreel.video)}>{home.showreel.label}</a>
    </video></div> : <div class="showreel-frame media-placeholder" role="img" aria-label={home.showreel.placeholder}>
      {home.showreel.poster ? <img class="showreel-poster" src={assetUrl(home.showreel.poster)} alt={home.showreel.label} width="1440" height="810" fetchpriority="high" /> : <div class="showreel-placeholder-content"><span class="play-mark"><Icon name="play" size={25} /></span><span>{home.showreel.placeholder}</span></div>}
      <span class="showreel-caption">{home.showreel.label}<Icon name="arrow" size={17} /></span>
    </div>}
    </div>
    <div class="intro-panel">
      <h1 id="intro-heading">{home.heading}</h1>
      <p class="intro-blurb">{home.blurb}</p>
    </div>
  </section>

  {companies.length > 0 && <section class="companies-panel panel" aria-label={home.companiesLabel}>
    <ul class="company-list">{companies.map((company) => <li>
      {company.url ? <a href={company.url} target="_blank" rel="noopener noreferrer" class="company" aria-label={company.name}>
        {company.logo ? <img src={assetUrl(company.logo)} alt={company.name} loading="lazy" /> : company.icon && <Icon name={company.icon} size={25} />}
      </a> : <span class="company" aria-label={company.name}>{company.logo ? <img src={assetUrl(company.logo)} alt={company.name} loading="lazy" /> : company.icon && <Icon name={company.icon} size={25} />}</span>}
    </li>)}</ul>
  </section>}

</Layout>
